# Copie para .env.local e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API). Sem essas variáveis o app roda em modo demonstração,
# salvando o progresso só no navegador.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Só para o script de carga (npm run seed). NUNCA coloque esta chave no app nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=
