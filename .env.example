# Copie para .env (ou .env.local) e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API Keys). Sem essas variáveis o app roda em modo demonstração,
# salvando o progresso só no navegador.

# URL da API (https://<id-do-projeto>.supabase.co), não o link do painel
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave publishable (sb_publishable_...) ou anon legada (eyJ...): pública, vai no app
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Chave secret (sb_secret_...) ou service_role legada: só para o script de carga (npm run seed).
# NUNCA coloque esta chave no app nem no GitHub.
SUPABASE_SERVICE_ROLE_KEY=
