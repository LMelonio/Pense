{
  "name": "pense-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Pense — app de estudos para provas, concursos e processos seletivos",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "seed": "node scripts/seed-supabase.mjs",
    "gerar-sql": "node scripts/gerar-seed-sql.mjs",
    "importar-excel": "node scripts/importar-excel.mjs",
    "exportar-excel": "node scripts/exportar-excel.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "@supabase/supabase-js": "2.117.3",
    "dompurify": "3.4.17",
    "katex": "0.16.47",
    "marked": "14.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "24.19.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "exceljs": "4.4.0",
    "typescript": "5.6.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
